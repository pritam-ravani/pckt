<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no cloud backup and no device-to-device copy. The database is
     encrypted with a key that lives in this phone's keystore, so a copied
     database could not be opened anyway; financial data stays on the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
